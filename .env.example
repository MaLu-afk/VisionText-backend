# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Server (en Railway, PORT lo inyecta la plataforma)
HOST=0.0.0.0
PORT=8000

# URL pública del backend: se usa para construir las URLs de imágenes que recibe el navegador
BASE_URL=http://localhost:8000

# CLIP Model
CLIP_MODEL=ViT-L-14
CLIP_PRETRAINED=openai
CACHE_DIR=./model_cache

# PostgreSQL (driver asyncpg obligatorio)
POSTGRES_URL=postgresql+asyncpg://usuario:clave@host:5432/basedatos

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cambia-este-usuario
MINIO_SECRET_KEY=cambia-esta-clave
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=visiontext-images
MINIO_BUCKET_THUMBNAILS=visiontext-thumbnails

# FAISS Index
FAISS_INDEX_PATH=./faiss_indices/faiss_index.bin

# Search & Upload
MAX_UPLOAD_SIZE=10485760
THUMBNAIL_SIZE=256
DEFAULT_SEARCH_LIMIT=20
TEXT_SEARCH_THRESHOLD=0.18
IMAGE_SEARCH_THRESHOLD=0.65
SIMILARITY_THRESHOLD=0.20

# CORS: orígenes del frontend separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin (genera JWT_SECRET_KEY con: openssl rand -hex 32)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET_KEY=cambia-este-secreto

# Límite de intentos fallidos de login (opcional)
LOGIN_MAX_ATTEMPTS_PER_IP=5
LOGIN_MAX_ATTEMPTS_PER_USERNAME=10
LOGIN_WINDOW_SECONDS=900
